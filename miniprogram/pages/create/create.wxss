.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

.nav-bar {
  background: #FFFFFF;
  border-bottom: 1px solid #F0F0F0;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 22px;
  font-weight: 700;
  color: #1A1A1A;
}

.content {
  flex: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200px;
}

.empty-icon-wrap {
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 50%;
  margin-bottom: 20px;
}

.empty-icon {
  font-size: 36px;
}

.empty-title {
  font-size: 16px;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: #999999;
  margin-bottom: 32px;
}

.create-btn {
  padding: 12px 32px;
  background: #1E3A8A;
  border-radius: 24px;
}

.create-btn:active {
  background: #1E40AF;
}

.create-btn-text {
  font-size: 15px;
  font-weight: 500;
  color: #FFFFFF;
}

.tab-bar-placeholder {
  height: 65px;
}

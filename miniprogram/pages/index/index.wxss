.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  background: #FFFFFF;
  border-bottom: 1px solid #F0F0F0;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
}

.nav-title {
  font-size: 22px;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5px;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-action-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 50%;
}

.nav-action-btn:active {
  background: #E8E8E8;
}

.nav-action-icon {
  font-size: 20px;
  color: #1A1A1A;
  font-weight: 300;
  line-height: 1;
}

/* ========== 对话列表 ========== */
.chat-list {
  flex: 1;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200px;
}

.empty-icon-wrap {
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 50%;
  margin-bottom: 20px;
}

.empty-icon {
  font-size: 36px;
}

.empty-title {
  font-size: 16px;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: #999999;
}

/* 对话条目 */
.chat-item {
  display: flex;
  align-items: center;
  padding: 16px 20px;
  gap: 14px;
  transition: background 0.2s;
}

.chat-item:active {
  background: #F5F5F5;
}

.chat-item-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-item-avatar-text {
  font-size: 18px;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
}

.chat-item-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.chat-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-item-title {
  font-size: 16px;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 12px;
}

.chat-item-time {
  font-size: 12px;
  color: #BBBBBB;
  flex-shrink: 0;
}

.chat-item-summary {
  font-size: 14px;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.chat-item-unread {
  flex-shrink: 0;
  width: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unread-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #FF3B30;
}

/* ========== 底部TabBar占位 ========== */
.tab-bar-placeholder {
  height: 65px;
}

/* ========== 弹窗遮罩（通用） ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 200;
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 100;
  opacity: 0;
  animation: fadeInMask 0.25s ease forwards;
}

@keyframes fadeInMask {
  to { opacity: 1; }
}

/* ========== 长按菜单 - 底部弹出 ========== */
.menu-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24px 24px 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.08);
}

.menu-sheet.show {
  transform: translateY(0);
}

/* 菜单顶部拖拽条 */
.menu-sheet::before {
  content: '';
  display: block;
  width: 36px;
  height: 4px;
  background: #E5E5E5;
  border-radius: 2px;
  margin: 10px auto 0;
}

.menu-sheet-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px 28px;
  font-size: 16px;
  color: #1A1A1A;
  border-bottom: 0.5px solid #F2F2F2;
  transition: background 0.15s ease;
}

.menu-sheet-item:active {
  background: #F5F5F5;
}

.menu-sheet-item:last-of-type {
  border-bottom: none;
}

.menu-danger {
  color: #FF3B30;
}

.menu-icon {
  font-size: 22px;
  width: 28px;
  text-align: center;
}

.menu-sheet-cancel {
  padding: 18px;
  text-align: center;
  font-size: 15px;
  color: #AAAAAA;
  margin: 8px 16px 0;
  background: #F7F8FA;
  border-radius: 14px;
  transition: background 0.15s ease;
}

.menu-sheet-cancel:active {
  background: #EDEEF0;
}

/* ========== 重命名弹窗 ========== */
.rename-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(0.7) translateY(30px);
  width: 320px;
  background: #FFFFFF;
  border-radius: 24px;
  padding: 32px 24px 20px;
  z-index: 201;
  opacity: 0;
  pointer-events: none;
  transition: all 0.35s cubic-bezier(0.34, 1.8, 0.64, 1);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
}

.rename-modal.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1) translateY(0);
  pointer-events: auto;
}

.rename-modal-title {
  font-size: 18px;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 20px;
  letter-spacing: 0.5px;
}

.rename-input {
  width: 100%;
  height: 44px;
  border: 1px solid #EAEAEA;
  border-radius: 12px;
  padding: 0 16px;
  font-size: 15px;
  color: #1A1A1A;
  background: #F8FAFC;
  box-sizing: border-box;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.rename-input:focus {
  border-color: #3B82F6;
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.rename-modal-btns {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.rename-btn {
  flex: 1;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.rename-cancel {
  background: #F5F5F5;
  color: #888888;
}

.rename-cancel:active {
  background: #E8E8E8;
}

.rename-confirm {
  background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
  color: #FFFFFF;
  box-shadow: 0 4px 12px rgba(30, 58, 138, 0.25);
}

.rename-confirm:active {
  transform: scale(0.97);
  box-shadow: 0 2px 6px rgba(30, 58, 138, 0.15);
}

<view class="page">
  <!-- 自定义顶部栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
      <text class="nav-title">对话</text>
      <view class="nav-actions">
        <view class="nav-action-btn" bindtap="onNewChat">
          <text class="nav-action-icon">+</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 对话列表 -->
  <scroll-view class="chat-list" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{conversations.length === 0}}">
      <view class="empty-icon-wrap">
        <text class="empty-icon">💬</text>
      </view>
      <text class="empty-title">暂无对话</text>
      <text class="empty-desc">点击右上角 + 开始新的 AI 创作</text>
    </view>

    <!-- 对话条目 -->
    <view 
      class="chat-item" 
      wx:for="{{conversations}}" 
      wx:key="id"
      bindtap="onOpenChat"
      bindlongpress="onLongPress"
      data-id="{{item.id}}"
      data-index="{{index}}"
    >
      <view class="chat-item-avatar" style="background: {{item.color}};">
        <text class="chat-item-avatar-text">{{item.avatarText}}</text>
      </view>
      <view class="chat-item-content">
        <view class="chat-item-top">
          <text class="chat-item-title">{{item.title}}</text>
          <text class="chat-item-time">{{item.timeDisplay}}</text>
        </view>
        <text class="chat-item-summary">{{item.summary || '暂无消息'}}</text>
      </view>
      <view class="chat-item-unread" wx:if="{{item.unread}}">
        <text class="unread-dot"></text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部导航栏占位 -->
  <view class="tab-bar-placeholder"></view>
</view>

<!-- 长按菜单弹窗 -->
<view class="menu-mask" wx:if="{{showMenu}}" bindtap="hideMenu"></view>
<view class="menu-sheet {{showMenu ? 'show' : ''}}">
  <view class="menu-sheet-item" bindtap="onPinConversation">
    <text class="menu-icon">📌</text>
    <text>{{targetConversation.pinned ? '取消置顶' : '置顶对话'}}</text>
  </view>
  <view class="menu-sheet-item" bindtap="onRenameConversation">
    <text class="menu-icon">✏️</text>
    <text>重命名</text>
  </view>
  <view class="menu-sheet-item menu-danger" bindtap="onDeleteConversation">
    <text class="menu-icon">🗑️</text>
    <text>删除对话</text>
  </view>
  <view class="menu-sheet-cancel" bindtap="hideMenu">取消</view>
</view>

<!-- 重命名弹窗 -->
<view class="modal-mask fade-in" wx:if="{{showRenameModal}}" bindtap="hideRenameModal"></view>
<view class="rename-modal {{showRenameModal ? 'show' : ''}}">
  <view class="rename-modal-title">重命名对话</view>
  <input 
    class="rename-input" 
    placeholder="请输入新名称" 
    value="{{renameValue}}" 
    bindinput="onRenameInput"
    placeholderStyle="color: #BBBBBB"
    focus="{{showRenameModal}}"
  />
  <view class="rename-modal-btns">
    <view class="rename-btn rename-cancel" bindtap="hideRenameModal">取消</view>
    <view class="rename-btn rename-confirm" bindtap="onConfirmRename">确认</view>
  </view>
</view>

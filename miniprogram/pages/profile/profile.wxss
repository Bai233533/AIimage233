.profile-page {
  min-height: 100vh;
  background: #F5F7FA;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.nav-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

/* ========== 用户信息卡片 ========== */
.user-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-avatar-wrap {
  margin-right: 24rpx;
}

.user-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8E8E8 0%, #D0D0D0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #E8E8E8;
}

.avatar-member {
  background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
  border-color: #1E3A8A;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 10rpx;
}

.user-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.badge-free {
  background: #F5F5F5;
}

.badge-free .badge-text {
  color: #999999;
}

.badge-member {
  background: #EBF5FF;
  border: 1rpx solid #B3D8FF;
}

.badge-member .badge-text {
  color: #1E3A8A;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* ========== 通用卡片区块 ========== */
.section-card {
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.section-header {
  padding: 24rpx 32rpx 0;
}

.section-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #999999;
  letter-spacing: 1rpx;
}

/* ========== 状态行 ========== */
.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.status-row:last-child {
  border-bottom: none;
}

.status-key {
  font-size: 28rpx;
  color: #666666;
}

.status-val {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.val-active {
  color: #1E3A8A;
}

/* ========== 菜单列表 ========== */
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background 0.15s;
}

.menu-item:active {
  background: #F8F8F8;
}

.menu-last {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 36rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #1A1A1A;
}

.danger-text {
  color: #E53E3E;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* ========== 版本号 ========== */
.footer {
  text-align: center;
  padding: 48rpx 0 24rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #CCCCCC;
}

/* ========== TabBar 占位 ========== */
.tab-bar-placeholder {
  height: 130rpx;
}

/* ==================== 弹窗系统 ==================== */

/* 遮罩层 - 毛玻璃 + 淡入 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 1000;
  opacity: 0;
  transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.modal-mask.fade-in {
  opacity: 1;
}

/* 居中弹窗容器 */
.modal-center {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
  pointer-events: none;
}

/* 弹窗卡片 - 弹性缩放 */
.modal-card {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 56rpx 48rpx 40rpx;
  pointer-events: auto;
  transform: scale(0.7) translateY(40rpx);
  opacity: 0;
  transition: all 0.4s cubic-bezier(0.34, 1.8, 0.64, 1);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.12);
}

.pop-in .modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

/* 登录/注册切换标签 */
.modal-tabs {
  display: flex;
  margin-bottom: 44rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.modal-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #AAAAAA;
  position: relative;
  transition: all 0.3s ease;
}

.tab-active {
  color: #1E3A8A;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 30%;
  width: 40%;
  height: 4rpx;
  background: linear-gradient(90deg, #1E3A8A, #3B82F6);
  border-radius: 4rpx;
  animation: tabSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes tabSlideIn {
  from { transform: scaleX(0); opacity: 0; }
  to { transform: scaleX(1); opacity: 1; }
}

/* 表单区域 */
.modal-form {
  margin-bottom: 36rpx;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.modal-subtitle {
  font-size: 26rpx;
  color: #AAAAAA;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

/* 主按钮 - 渐变深蓝 */
.modal-btn-primary {
  width: 100% !important;
  height: 88rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%) !important;
  border-radius: 20rpx;
  color: #FFFFFF !important;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 138, 0.3);
  transition: all 0.2s ease;
}

.modal-btn-primary::after {
  border: none;
}

.modal-btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.2);
}

/* 取消文字 */
.modal-cancel {
  text-align: center;
  font-size: 28rpx;
  color: #BBBBBB;
  margin-top: 24rpx;
  padding: 16rpx 0;
  transition: color 0.2s;
}

.modal-cancel:active {
  color: #888888;
}

/* 输入框 */
.modal-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #EAEAEA;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  background: #F8FAFC;
  box-sizing: border-box;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.modal-input:focus {
  border-color: #3B82F6;
  background: #FFFFFF;
  box-shadow: 0 0 0 4rpx rgba(37, 99, 235, 0.08);
}

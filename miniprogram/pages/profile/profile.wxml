<view class="profile-page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
      <text class="nav-title">我的</text>
    </view>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar-wrap">
      <view class="user-avatar {{isMember ? 'avatar-member' : ''}}">
        <text class="avatar-text">{{isLoggedIn ? username[0] || '用' : '?'}}</text>
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{isLoggedIn ? username : '未登录'}}</text>
      <view class="user-badge {{isMember ? 'badge-member' : 'badge-free'}}">
        <text class="badge-text">{{isMember ? '会员用户' : '免费用户'}}</text>
      </view>
    </view>
  </view>

  <!-- 会员状态 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-label">会员状态</text>
    </view>
    <view class="status-row">
      <text class="status-key">{{isMember ? '有效期至' : '当前状态'}}</text>
      <text class="status-val {{isMember ? 'val-active' : ''}}">{{isMember ? expireTime : '未开通'}}</text>
    </view>
    <view class="status-row">
      <text class="status-key">剩余次数</text>
      <text class="status-val">{{isMember ? '无限次' : (freeLimit - freeUsed) + '/' + freeLimit}}</text>
    </view>
  </view>

  <!-- 操作列表 -->
  <view class="section-card">
    <view class="menu-item" bindtap="showLoginModalAction">
      <view class="menu-left">
        <text class="menu-icon">�</text>
        <text class="menu-text">{{isLoggedIn ? '账号信息' : '账号密码登录'}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onCardKeyTap">
      <view class="menu-left">
        <text class="menu-icon">🎫</text>
        <text class="menu-text">卡密兑换</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item menu-last" wx:if="{{isLoggedIn}}" bindtap="onLogout">
      <view class="menu-left">
        <text class="menu-icon">🚪</text>
        <text class="menu-text danger-text">退出登录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版本号 -->
  <view class="footer">
    <text class="footer-text">AI漫剧大师 v1.0</text>
  </view>

  <!-- TabBar 占位 -->
  <view class="tab-bar-placeholder"></view>
</view>

<!-- ========== 账号密码登录弹窗 ========== -->
<view class="modal-mask {{showLoginModal ? 'fade-in' : ''}}" wx:if="{{showLoginModal}}" bindtap="hideLoginModal"></view>
<view class="modal-center {{showLoginModal ? 'pop-in' : ''}}" wx:if="{{showLoginModal}}">
  <view class="modal-card">
    <!-- 登录/注册切换标签 -->
    <view class="modal-tabs">
      <view class="modal-tab {{loginMode === 'login' ? 'tab-active' : ''}}" bindtap="switchToLogin">登录</view>
      <view class="modal-tab {{loginMode === 'register' ? 'tab-active' : ''}}" bindtap="switchToRegister">注册</view>
    </view>

    <!-- 登录表单 -->
    <block wx:if="{{loginMode === 'login'}}">
      <view class="modal-form">
        <input class="modal-input" placeholder="请输入账号" value="{{loginUsername}}" bindinput="onLoginUsernameInput" placeholderStyle="color: #BBBBBB" />
        <input class="modal-input" placeholder="请输入密码" value="{{loginPassword}}" bindinput="onLoginPasswordInput" password placeholderStyle="color: #BBBBBB" />
      </view>
      <button class="modal-btn-primary" bindtap="onPasswordLogin">登录</button>
    </block>

    <!-- 注册表单 -->
    <block wx:if="{{loginMode === 'register'}}">
      <view class="modal-form">
        <input class="modal-input" placeholder="请设置账号（2-20位）" value="{{regUsername}}" bindinput="onRegUsernameInput" placeholderStyle="color: #BBBBBB" />
        <input class="modal-input" placeholder="请设置密码（6-20位）" value="{{regPassword}}" bindinput="onRegPasswordInput" password placeholderStyle="color: #BBBBBB" />
        <input class="modal-input" placeholder="请确认密码" value="{{regPasswordConfirm}}" bindinput="onRegPasswordConfirmInput" password placeholderStyle="color: #BBBBBB" />
      </view>
      <button class="modal-btn-primary" bindtap="onPasswordRegister">注册并登录</button>
    </block>

    <view class="modal-cancel" bindtap="hideLoginModal">取消</view>
  </view>
</view>

<!-- ========== 卡密兑换弹窗 ========== -->
<view class="modal-mask {{showCardKeyModal ? 'fade-in' : ''}}" wx:if="{{showCardKeyModal}}" bindtap="hideCardKeyModal"></view>
<view class="modal-center {{showCardKeyModal ? 'pop-in' : ''}}" wx:if="{{showCardKeyModal}}">
  <view class="modal-card">
    <view class="modal-title">卡密兑换</view>
    <view class="modal-subtitle">输入卡密兑换1个月会员</view>
    <input
      class="modal-input"
      placeholder="请输入卡密，如 VIP-AB3D-K9F2"
      value="{{cardKeyInput}}"
      bindinput="onCardKeyInput"
      placeholderStyle="color: #BBBBBB"
    />
    <button class="modal-btn-primary" bindtap="onVerifyCardKey">确认兑换</button>
    <view class="modal-cancel" bindtap="hideCardKeyModal">取消</view>
  </view>
</view>

.container {
  padding: 16px;
  padding-bottom: 40px;
  min-height: 100vh;
  background: #FFFFFF;
}

/* 头部操作 */
.header-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16px;
}

.clear-btn {
  padding: 6px 12px;
  background: #F5F5F5;
  border: 1px solid #E8E8E8;
  border-radius: 4px;
  font-size: 13px;
  color: #666666;
  letter-spacing: 0.2px;
}

/* 时间筛选栏 */
.filter-bar {
  display: flex;
  gap: 12px;
  margin-bottom: 20px;
}

.filter-item {
  padding: 8px 16px;
  background: #FFFFFF;
  border: 1px solid #E8E8E8;
  border-radius: 4px;
  font-size: 13px;
  color: #666666;
  transition: all 0.2s ease;
  letter-spacing: 0.2px;
}

.filter-active {
  background: #1E3A8A;
  border-color: transparent;
  color: #FFFFFF;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}

.empty-icon-wrap {
  width: 100px;
  height: 100px;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  border: 1px solid #E8E8E8;
}

.empty-icon {
  font-size: 40px;
}

.empty-text {
  font-size: 16px;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 6px;
  letter-spacing: 0.2px;
}

.empty-hint {
  font-size: 13px;
  color: #999999;
}

/* 历史记录列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* 卡片样式 - 单张 */
.history-card {
  background: #FFFFFF;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid #E8E8E8;
}

.card-image-wrap {
  position: relative;
  width: 100%;
  height: 260px;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-info {
  padding: 12px;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

.tag-item {
  padding: 4px 8px;
  border-radius: 2px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.2px;
}

.tag-platform {
  background: #F5F5F5;
  color: #666666;
  border: 1px solid #E8E8E8;
}

.tag-ratio {
  background: #E8F4FD;
  color: #1E3A8A;
  border: 1px solid #B3D8FF;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-date {
  font-size: 12px;
  color: #999999;
}

/* 分组样式 */
.history-group {
  background: #FFFFFF;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid #E8E8E8;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px;
  border-bottom: 1px solid #E8E8E8;
}

.group-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.group-count-badge {
  padding: 4px 8px;
  background: #1E3A8A;
  border-radius: 2px;
  font-size: 12px;
  font-weight: 500;
  color: #FFFFFF;
  letter-spacing: 0.2px;
}

.group-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.group-date {
  font-size: 12px;
  color: #999999;
}

.group-tags {
  display: flex;
  gap: 6px;
}

.mini-tag {
  font-size: 10px;
  color: #666666;
  background: #F5F5F5;
  padding: 2px 6px;
  border-radius: 2px;
  border: 1px solid #E8E8E8;
}

.group-expand {
  width: 28px;
  height: 28px;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #999999;
  transition: transform 0.2s ease;
  border: 1px solid #E8E8E8;
}

.group-expand.expanded {
  transform: rotate(90deg);
}

/* 分组图片预览 */
.group-preview {
  position: relative;
  width: 100%;
  height: 220px;
}

.preview-main {
  width: 100%;
  height: 100%;
}

.preview-count {
  position: absolute;
  bottom: 10px;
  right: 10px;
  padding: 6px 12px;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 2px;
  font-size: 13px;
  font-weight: 500;
  color: #FFFFFF;
  backdrop-filter: blur(4px);
  letter-spacing: 0.2px;
}

/* 展开的图片列表 */
.group-images-expanded {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.expanded-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px;
  background: #F5F5F5;
  border-radius: 4px;
  border: 1px solid #E8E8E8;
}

.expanded-index {
  width: 24px;
  height: 24px;
  background: #1E3A8A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 500;
  color: #FFFFFF;
  flex-shrink: 0;
}

.expanded-image {
  flex: 1;
  height: 70px;
  border-radius: 2px;
}

/* 图片加载失败样式 */
.card-image-wrap,
.group-preview {
  position: relative;
}

.image-error {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #E8E8E8;
}

.error-text {
  font-size: 13px;
  color: #999999;
}

.expanded-error {
  position: absolute;
  top: 0;
  left: 36px;
  right: 0;
  bottom: 0;
  border-radius: 2px;
}

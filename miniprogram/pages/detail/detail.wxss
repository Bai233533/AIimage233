.container {
  padding: 16px;
  padding-bottom: 40px;
  background: #FFFFFF;
}

/* 图片预览区域 */
.image-section {
  margin-bottom: 16px;
}

.detail-image {
  width: 100%;
  height: 380px;
  border-radius: 4px;
  background: #F5F5F5;
  border: 1px solid #E8E8E8;
}

.image-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 10px;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: #F5F5F5;
  border: 1px solid #E8E8E8;
  border-radius: 4px;
  font-size: 13px;
  color: #666666;
  letter-spacing: 0.2px;
}

.share-btn {
  margin: 0;
  padding: 8px 14px;
  line-height: 1.4;
}

.share-btn::after {
  border: none;
}

.action-icon {
  font-size: 14px;
}

/* 原图区域 */
.source-section {
  margin-bottom: 16px;
  padding: 12px;
  background: #F5F5F5;
  border-radius: 4px;
  border: 1px solid #E8E8E8;
}

.source-label {
  font-size: 13px;
  font-weight: 500;
  color: #666666;
  margin-bottom: 10px;
  letter-spacing: 0.2px;
}

.source-image {
  width: 100%;
  height: 180px;
  border-radius: 2px;
}

/* 参考图区域 */
.reference-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.reference-image {
  width: calc(33.33% - 8px);
  height: 90px;
  border-radius: 2px;
}

/* 批量图片缩略图 */
.batch-thumbs {
  margin-bottom: 16px;
}

.batch-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  font-size: 13px;
  color: #666666;
  letter-spacing: 0.2px;
}

.save-all-btn {
  padding: 4px 10px;
  background: #1E3A8A;
  border-radius: 2px;
  font-size: 11px;
  color: #FFFFFF;
  letter-spacing: 0.2px;
}

.thumbs-scroll {
  width: 100%;
  white-space: nowrap;
}

.thumbs-list {
  display: inline-flex;
  gap: 10px;
  padding: 4px 0;
}

.thumb-item {
  position: relative;
  width: 70px;
  height: 70px;
  border-radius: 4px;
  overflow: hidden;
  border: 2px solid transparent;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.thumb-active {
  border-color: #1E3A8A;
}

.thumb-image {
  width: 100%;
  height: 100%;
}

.thumb-index {
  position: absolute;
  top: 4px;
  left: 4px;
  width: 18px;
  height: 18px;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: #FFFFFF;
}

/* 信息卡片 */
.info-card {
  padding: 16px;
  background: #F5F5F5;
  border-radius: 4px;
  border: 1px solid #E8E8E8;
}

.info-row {
  display: flex;
  margin-bottom: 16px;
}

.info-item {
  flex: 1;
}

.info-item.full-width {
  flex: none;
  width: 100%;
}

.info-label {
  display: block;
  font-size: 12px;
  color: #999999;
  margin-bottom: 4px;
  letter-spacing: 0.2px;
}

.info-value {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 0.2px;
}

/* 分隔线 */
.divider {
  height: 1px;
  background: #E8E8E8;
  margin: 16px 0;
}

/* 提示词区域 */
.prompt-section {
  margin-top: 4px;
}

.prompt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.prompt-title {
  font-size: 14px;
  font-weight: 500;
  color: #1E3A8A;
  letter-spacing: 0.3px;
}

.copy-btn {
  padding: 4px 10px;
  background: #F5F5F5;
  border: 1px solid #E8E8E8;
  border-radius: 2px;
  font-size: 12px;
  color: #666666;
  letter-spacing: 0.2px;
}

.prompt-content {
  padding: 12px;
  background: #FFFFFF;
  border-radius: 4px;
  font-size: 13px;
  line-height: 1.7;
  color: #1A1A1A;
  border: 1px solid #E8E8E8;
}

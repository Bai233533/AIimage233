<view class="tabbar-container">
  <view class="tabbar-content">
    <!-- 首页 -->
    <view class="tabbar-item {{selected === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
      <view class="tabbar-icon-wrap">
        <image class="tabbar-icon" src="{{selected === 0 ? '/images/icons/navbar/home-active.svg' : '/images/icons/navbar/home.svg'}}" mode="aspectFit"/>
        <view class="tabbar-icon-bg"></view>
      </view>
      <text class="tabbar-text">首页</text>
    </view>
    
    <!-- 历史记录 -->
    <view class="tabbar-item {{selected === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
      <view class="tabbar-icon-wrap">
        <image class="tabbar-icon" src="{{selected === 1 ? '/images/icons/navbar/history-active.svg' : '/images/icons/navbar/history.svg'}}" mode="aspectFit"/>
        <view class="tabbar-icon-bg"></view>
      </view>
      <text class="tabbar-text">历史记录</text>
    </view>
    
    <!-- 我的 -->
    <view class="tabbar-item {{selected === 2 ? 'active' : ''}}" bindtap="switchTab" data-index="2">
      <view class="tabbar-icon-wrap">
        <image class="tabbar-icon" src="{{selected === 2 ? '/images/icons/navbar/profile-active.svg' : '/images/icons/navbar/profile.svg'}}" mode="aspectFit"/>
        <view class="tabbar-icon-bg"></view>
      </view>
      <text class="tabbar-text">我的</text>
    </view>
  </view>
</view>
<view class="tab-bar">
  <!-- 顶部滑动指示条 -->
  <view class="tab-indicator" style="transform: translateX({{selected * 100}}%)">
    <view class="tab-indicator-bar"></view>
  </view>

  <view
    class="tab-bar-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <text class="tab-icon">{{item.icon}}</text>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>

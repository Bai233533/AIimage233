.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 65px;
  background: #FFFFFF;
  position: relative;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2px 16px rgba(0, 0, 0, 0.05);
}

/* ========== 顶部滑动指示条 ========== */
.tab-indicator {
  position: absolute;
  top: 0;
  left: 0;
  width: 25%;
  height: 3px;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 2;
}

.tab-indicator-bar {
  width: 28px;
  height: 3px;
  border-radius: 3px;
  background: linear-gradient(90deg, #1E3A8A, #2563EB);
  box-shadow: 0 1px 8px rgba(37, 99, 235, 0.35);
}

/* ========== Tab Item ========== */
.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  gap: 3px;
  padding: 8px 0;
  position: relative;
  transition: all 0.3s ease;
}

.tab-bar-item:active {
  opacity: 0.7;
}

/* ========== 图标容器 ========== */
.tab-icon-wrap {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-icon {
  font-size: 20px;
  transition: all 0.3s ease;
}

/* ========== 文字 ========== */
.tab-text {
  font-size: 10px;
  color: #AAAAAA;
  font-weight: 500;
  transition: all 0.3s ease;
}

/* ========== Active 选中态 ========== */
.tab-bar-item.active .tab-icon-wrap {
  background: rgba(30, 58, 138, 0.1);
  transform: translateY(-3px);
}

.tab-bar-item.active .tab-icon {
  transform: scale(1.15);
}

.tab-bar-item.active .tab-text {
  color: #1E3A8A;
  font-weight: 600;
}
